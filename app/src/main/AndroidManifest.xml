<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <queries>
        <package android:name="com.umetrip.android.msky.app"/>
    </queries>
    <application android:label="@string/app_name" android:description="@string/app_description" android:allowBackup="false" android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <receiver android:name=".DownloadProgressReceiver" android:exported="true"/>
        <provider android:name=".DownloadNotifications" android:authorities="com.ohyooo.lvtu.download" android:exported="true"/>
        <activity android:name=".NotificationPermissionActivity" android:exported="true" android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.INFO"/>
                <category android:name="de.robv.android.xposed.category.MODULE_SETTINGS"/>
            </intent-filter>
        </activity>
    </application>
</manifest>
